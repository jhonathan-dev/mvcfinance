# Copie este arquivo para ".env" e preencha com os seus valores.
# O ".env" real NUNCA deve ir para o Git (ele esta no .gitignore).

# Banco de dados (Neon / PostgreSQL)
DATABASE_URL=

# Clerk (autenticacao)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login

# Stripe (assinatura premium)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PLAN_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=

# OpenAI (Relatorio IA) - sem a chave, o sistema devolve um relatorio de exemplo
OPENAI_API_KEY=

# Vercel Blob (upload de imagens do admin)
BLOB_READ_WRITE_TOKEN=
