// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Operation {
  id              String                @id @default(uuid())
  name            String
  amount          Decimal               @db.Decimal(10, 2)
  date            DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  userId          String

  typeId          String
  type            OperationType         @relation(fields: [typeId], references: [id])

  categoryId      String
  category        OperationCategory     @relation(fields: [categoryId], references: [id])

  paymentMethodId String
  paymentMethod   OperationPaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("operations")
}

model OperationType {
  id         String      @id @default(uuid())
  label      String
  active     Boolean     @default(true)
  isDefault  Boolean     @default(false)  // protege os padrões de exclusão
  userId     String?     // null = global/padrão do sistema
  operations Operation[]

  @@map("operation_types")
}

model OperationCategory {
  id         String      @id @default(uuid())
  label      String
  active     Boolean     @default(true)
  isDefault  Boolean     @default(false)
  userId     String?
  operations Operation[]

  @@map("operation_categories")
}

model OperationPaymentMethod {
  id         String      @id @default(uuid())
  label      String
  active     Boolean     @default(true)
  isDefault  Boolean     @default(false)
  userId     String?
  operations Operation[]

  @@map("operation_payment_methods")
}