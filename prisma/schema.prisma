generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id            String                   @id @default(uuid())
  name          String
  type          TransactionType
  amount        Decimal                  @db.Decimal(10, 2)
  category      TransactionCategory
  paymentMethod TransactionPaymentMethod
  date          DateTime
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userId        String
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransactionCategory {
  // EXPENSE
  HOUSING
  TRANSPORTATION
  FOOD
  HEALTH
  EDUCATION
  ENTERTAINMENT
  CLOTHING
  BEAUTY
  PETS
  TRAVEL
  SUBSCRIPTIONS
  PHONE_INTERNET
  ENERGY_WATER
  TAXES
  INSURANCE
  // DEPOSIT
  SALARY
  FREELANCE
  RENTAL_INCOME
  DIVIDENDS
  REFUND
  GIFT_RECEIVED
  ASSET_SALE
  // INVESTMENT
  FIXED_INCOME
  VARIABLE_INCOME
  REAL_ESTATE_FUNDS
  CRYPTO
  PRIVATE_PENSION
  SAVINGS
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
}